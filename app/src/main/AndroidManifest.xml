<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Allot">

        <activity
            android:name=".view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Allot.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.MainActivity"
            android:exported="true" />
        <activity
            android:name=".view.MyEventsActivity"
            android:exported="false" />
        <activity
            android:name=".view.CreateEventActivity"
            android:exported="false" />
        <activity
            android:name=".view.CreateEventSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".view.EventQrCodeActivity"
            android:exported="false" />
        <activity
            android:name=".view.EventDetailActivity"
            android:exported="false" />
        <activity
            android:name=".view.ManageEventActivity"
            android:exported="false" />
        <activity
            android:name=".view.ManageLotteryActivity"
            android:exported="false" />
        <activity
            android:name=".view.EventOfferActivity"
            android:exported="false" />
        <activity
            android:name=".view.ManageEntrantsActivity"
            android:exported="false" />
        <activity
            android:name=".view.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".view.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".view.NameActivity"
            android:exported="false" />
        <activity
            android:name=".view.EmailActivity"
            android:exported="false" />
        <activity
            android:name=".view.PhoneActivity"
            android:exported="false" />
        <activity
            android:name=".view.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name=".view.AdminEventListActivity"
            android:exported="false" />
            android:name=".view.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
