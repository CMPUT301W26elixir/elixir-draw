<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_profile_input"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- Profile Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/userNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/varela_round_regular"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/userEmailText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: user@example.com"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/varela_round_regular"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/userDeviceIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID: xxxxx"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/varela_round_regular"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/userRoleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role: user"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/varela_round_regular"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Delete Button -->
    <Button
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_delete"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/varela_round_regular"
        android:backgroundTint="#FF9E4141"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginStart="12dp"
        android:textAllCaps="false" />
</LinearLayout>
