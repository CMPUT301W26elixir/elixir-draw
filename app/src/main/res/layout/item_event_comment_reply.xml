<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:paddingStart="18dp">

    <TextView
        android:id="@+id/commentAuthorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/varela_round_regular"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/commentDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/varela_round_regular"
        android:textColor="#A6A8A5"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/commentBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/varela_round_regular"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/commentVoteRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/commentUpvoteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/varela_round_regular"
            android:text="@string/event_comment_upvote"
            android:textColor="#7A7A7A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/commentDownvoteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/varela_round_regular"
            android:text="@string/event_comment_downvote"
            android:textColor="#7A7A7A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/commentReplyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/varela_round_regular"
        android:text="@string/event_comment_reply"
        android:textColor="#7A7A7A"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/commentDeleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/varela_round_regular"
        android:text="@string/event_comment_delete"
        android:textColor="#C04B4B"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/commentReplyListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/commentReplyInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />
</LinearLayout>
