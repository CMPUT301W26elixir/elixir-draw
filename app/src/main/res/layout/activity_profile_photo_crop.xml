<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/profilePhotoCropTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/varela_round_regular"
        android:text="@string/profile_photo_crop_title"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/profilePhotoCropSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/varela_round_regular"
        android:gravity="center"
        android:text="@string/profile_photo_crop_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <com.example.allot.view.profile.ProfilePhotoCropView
        android:id="@+id/profilePhotoCropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cancelCropButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_waitlist_button_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:text="@string/profile_photo_crop_cancel"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/useCroppedPhotoButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_waitlist_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:text="@string/profile_photo_crop_use"
            android:textColor="#1D1D1D"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
