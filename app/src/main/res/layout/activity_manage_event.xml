<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@null"
                    android:contentDescription="@string/event_detail_back"
                    android:padding="10dp"
                    android:src="@drawable/arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/varela_round_regular"
                    android:text="@string/manage_event_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_my_events_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp">

                <FrameLayout
                    android:layout_width="136dp"
                    android:layout_height="82dp">

                    <View
                        android:id="@+id/eventImageBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_event_image_one" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/summaryTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/varela_round_regular"
                        android:maxLines="2"
                        android:text="@string/default_event_name"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/summaryLocationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/varela_round_regular"
                        android:maxLines="1"
                        android:text="@string/default_street_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/summaryDateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/varela_round_regular"
                        android:maxLines="1"
                        android:text="@string/default_date"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_manage_event_qr"
                    android:fontFamily="@font/varela_round_regular"
                    android:gravity="center"
                    android:text="@string/manage_event_qr"
                    android:textColor="#1D1D1D"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/entrantsLotteryButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_waitlist_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:text="@string/manage_event_lottery_section"
                android:textColor="#1D1D1D"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/inviteEntrantsButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_waitlist_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:text="@string/manage_event_invite_button"
                android:textColor="#1D1D1D"
                android:textSize="20sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/inviteCoOrganizerButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_waitlist_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:text="@string/manage_event_invite_coorganizer"
                android:textColor="#1D1D1D"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_name_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/eventNameInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_name_hint"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/manage_event_banner_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_upload"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/varela_round_regular"
                        android:text="@string/manage_event_banner_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_location_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/locationInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_location_hint"
                android:inputType="textPostalAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/visibilityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_visibility_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/privateEventCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/white"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_private_option"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/geolocationPreferencesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_geolocation_preferences"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/geolocationCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/white"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_enable_geolocation"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_start_date_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/startMonthSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_profile_input"
                    android:entries="@array/create_event_months"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

                <EditText
                    android:id="@+id/startDayInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_day_hint"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/startYearInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_year_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_price_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/priceInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_price_hint"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_description_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="top|start"
                android:hint="@string/create_event_description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_participants_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/participantsInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_participants_hint"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_registration_start_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/registrationStartMonthSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_profile_input"
                    android:entries="@array/create_event_months"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

                <EditText
                    android:id="@+id/registrationStartDayInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_day_hint"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/registrationStartYearInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_year_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_registration_end_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/registrationEndMonthSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_profile_input"
                    android:entries="@array/create_event_months"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:spinnerMode="dropdown" />

                <EditText
                    android:id="@+id/registrationEndDayInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_day_hint"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/registrationEndYearInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_profile_input"
                    android:fontFamily="@font/varela_round_regular"
                    android:hint="@string/create_event_year_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/saveChangesButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_waitlist_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:text="@string/manage_event_save_changes"
                android:textColor="#1D1D1D"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
