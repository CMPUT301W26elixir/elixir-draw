<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="72dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/createEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_title"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_name_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/eventNameInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_name_hint"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_location_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/locationInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_location_hint"
                android:inputType="textPostalAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_start_date_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/startDateInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_start_date_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_price_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/priceInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_price_hint"
                android:inputType="numberDecimal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_description_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="top|start"
                android:hint="@string/create_event_description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_participants_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/participantsInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_participants_hint"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_registration_start_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/registrationStartInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_registration_start_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/create_event_registration_end_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/registrationEndInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:hint="@string/create_event_registration_end_hint"
                android:inputType="date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/createEventNextButton"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_waitlist_button"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/varela_round_regular"
        android:gravity="center"
        android:text="@string/create_event_next"
        android:textColor="#1D1D1D"
        android:textSize="20sp" />

</LinearLayout>
