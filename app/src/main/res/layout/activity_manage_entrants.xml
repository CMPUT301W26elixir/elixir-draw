<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@null"
                    android:contentDescription="@string/event_detail_back"
                    android:padding="10dp"
                    android:src="@drawable/arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/varela_round_regular"
                    android:text="@string/manage_entrants_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/manage_lottery_draw_date"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/drawDateValueText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/manage_lottery_attendees"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/attendeesValueText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_input"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewEntrantMapButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/varela_round_regular"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/manage_entrants_view_map"
                android:textAllCaps="false"
                android:textColor="#1D1D1D"
                android:textSize="18sp"
                android:visibility="gone"
                app:backgroundTint="#F1F1F1"
                app:cornerRadius="22dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/selectedTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_manage_entrant_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:minWidth="82dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/manage_entrants_tab_selected"
                        android:textColor="#1D1D1D"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/cancelledTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_manage_entrant_tab_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:minWidth="90dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/manage_entrants_tab_cancelled"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/notEnrolledTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_manage_entrant_tab_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:minWidth="110dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/manage_entrants_tab_not_enrolled"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/enrolledTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_manage_entrant_tab_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:minWidth="84dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/manage_entrants_tab_enrolled"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/allEntrantsTabText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_manage_entrant_tab_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:minWidth="96dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/manage_entrants_tab_all"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/stateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/varela_round_regular"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/entrantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/exportFinalListButton"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:text="@string/manage_entrants_export_final_list"
        android:textAllCaps="false"
        android:textColor="#1D1D1D"
        android:textSize="18sp"
        android:visibility="gone"
        app:backgroundTint="#F1F1F1"
        app:cornerRadius="22dp" />
</LinearLayout>
