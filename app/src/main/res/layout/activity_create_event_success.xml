<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/event_detail_back"
            android:padding="10dp"
            android:src="@drawable/arrow_back" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_create_event_success_dot" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="110dp"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:text="@string/create_event_success_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_my_events_card"
            android:gravity="center_vertical"
            android:minHeight="98dp"
            android:orientation="horizontal"
            android:padding="7dp">

            <FrameLayout
                android:layout_width="136dp"
                android:layout_height="82dp">

                <View
                    android:id="@+id/imageBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/no_image" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:src="@drawable/event" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/varela_round_regular"
                    android:maxLines="2"
                    android:text="@string/default_event_name"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/locationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/varela_round_regular"
                    android:maxLines="1"
                    android:text="@string/default_street_name"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/varela_round_regular"
                    android:maxLines="1"
                    android:text="@string/default_date"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/generateQrButton"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_waitlist_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:text="@string/create_event_success_generate_qr"
            android:textColor="#1D1D1D"
            android:textSize="20sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/viewEventPageButton"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_waitlist_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:text="@string/create_event_success_view_event"
            android:textColor="#1D1D1D"
            android:textSize="20sp" />
    </LinearLayout>

    <com.example.allot.view.shared.BottomNavBarView
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
