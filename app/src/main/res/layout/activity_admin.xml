<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_panel_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:layout_marginEnd="24dp" />
    </LinearLayout>

    <!-- Tabs Slider -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/eventsTabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/admin_view_events"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

        <TextView
            android:id="@+id/photosTabText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_view_photos"
            android:textColor="@color/my_events_tab_inactive"
            android:textSize="16sp"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/postersTabText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/admin_view_posters"
            android:textColor="@color/my_events_tab_inactive"
            android:textSize="16sp"
            android:fontFamily="@font/varela_round_regular"
            android:gravity="center"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Events Container -->
        <LinearLayout
            android:id="@+id/eventsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- RecyclerView for events -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/eventsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <!-- Loading State for Events -->
            <LinearLayout
                android:id="@+id/eventsLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_loading_events"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- Empty State for Events -->
            <TextView
                android:id="@+id/eventsEmptyStateText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/admin_no_events"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/varela_round_regular"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Profiles Container -->
        <LinearLayout
            android:id="@+id/profilesContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- RecyclerView for profiles -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profilesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <!-- Loading State for Profiles -->
            <LinearLayout
                android:id="@+id/profilesLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_loading_profiles"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- Empty State for Profiles -->
            <TextView
                android:id="@+id/profilesEmptyStateText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/admin_no_profiles"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/varela_round_regular"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Profile Photos Container -->
        <LinearLayout
            android:id="@+id/photosContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photosRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/photosLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_loading_photos"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/photosEmptyStateText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/admin_no_photos"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/varela_round_regular"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Posters Container -->
        <LinearLayout
            android:id="@+id/postersContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postersRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/postersLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_loading_posters"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/varela_round_regular"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/postersEmptyStateText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/admin_no_posters"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/varela_round_regular"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Navigation -->
    <com.example.allot.view.shared.BottomNavBarView
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
