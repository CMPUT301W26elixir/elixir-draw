<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_delete_event_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="@font/varela_round_regular"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_delete_event_message"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="@font/varela_round_regular"
        android:layout_marginTop="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/eventTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event Title"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/varela_round_regular"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_waitlist_button"
            android:text="@string/admin_cancel"
            android:textColor="#1D1D1D"
            android:fontFamily="@font/varela_round_regular"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/deleteEventButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_waitlist_button"
            android:text="@string/admin_delete_event"
            android:textColor="#1D1D1D"
            android:fontFamily="@font/varela_round_regular"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
