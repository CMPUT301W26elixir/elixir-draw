<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="342dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_delete_profile_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/varela_round_regular"
        android:text="@string/admin_delete_event_title"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/varela_round_regular"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/admin_delete_event_message"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/eventTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/varela_round_regular"
        android:gravity="center"
        android:text="Event Title"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        android:layout_width="193dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/admin_cancel"
        android:textAllCaps="false"
        android:textColor="#1D1D1D"
        android:textSize="16sp"
        app:backgroundTint="#FFFFFFFF"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteEventButton"
        android:layout_width="193dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/admin_delete_event"
        android:textAllCaps="false"
        android:textColor="#1D1D1D"
        android:textSize="16sp"
        app:backgroundTint="#FFFFFFFF"
        app:cornerRadius="16dp" />
</LinearLayout>
