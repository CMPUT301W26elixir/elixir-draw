<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/heroImageFrame"
        android:layout_width="match_parent"
        android:layout_height="233dp"
        android:background="@drawable/bg_event_image_one">

        <ImageView
            android:id="@+id/heroPosterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_favorite_circle"
                android:contentDescription="@string/event_detail_back"
                android:padding="12dp"
                android:src="@drawable/arrow_back"
                app:tint="@color/text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/heroDeadlineText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:minWidth="128dp"
                android:paddingStart="18dp"
                android:paddingTop="11dp"
                android:paddingEnd="18dp"
                android:paddingBottom="11dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/favoriteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_favorite_circle"
                android:contentDescription="@string/event_detail_favorite"
                android:padding="11dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_event_detail_panel"
        android:orientation="vertical"
        android:paddingTop="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/eventTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/varela_round_regular"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="@string/default_event_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/eventPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="end"
                android:text="@string/default_price"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/eventLocationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/varela_round_regular"
                android:textColor="#A6A8A5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/eventDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/varela_round_regular"
                android:textColor="#A6A8A5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/eventOrganizerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/varela_round_regular"
                android:textColor="#A6A8A5"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#A6A8A5" />

        <TextView
            android:id="@+id/eventErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#FF7A7A"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/eventLoadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/eventDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/varela_round_regular"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/registrationOpenText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/varela_round_regular"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#A6A8A5"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/registrationDeadlineText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/varela_round_regular"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#A6A8A5"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#E2E2E2" />

                <TextView
                    android:id="@+id/eventCommentsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/varela_round_regular"
                    android:text="@string/event_comments_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/commentSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/varela_round_regular"
                        android:text="@string/event_comment_sort_label"
                        android:textColor="#A6A8A5"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/commentSortSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_profile_input"
                        android:entries="@array/event_comment_sort_options"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:spinnerMode="dropdown" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/commentInputText"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_input"
                        android:fontFamily="@font/varela_round_regular"
                        android:hint="@string/event_comment_placeholder"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="#A6A8A5"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/commentSubmitButton"
                        android:layout_width="86dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_waitlist_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/varela_round_regular"
                        android:gravity="center"
                        android:text="@string/event_comment_post"
                        android:textColor="#1D1D1D"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/commentEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/varela_round_regular"
                    android:text="@string/event_comments_empty"
                    android:textColor="#A6A8A5"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/commentsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_waitlist_container"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="17dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/waitlistStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/varela_round_regular"
                android:text="@string/event_detail_waitlist_joined_message"
                android:textColor="#A6A8A5"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/joinWaitingListButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_waitlist_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:text="@string/event_detail_join_waiting_list"
                android:textColor="#1D1D1D"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/actionSubtextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/varela_round_regular"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="#A6A8A5"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/entrantCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/varela_round_regular"
                android:textColor="#A6A8A5"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
