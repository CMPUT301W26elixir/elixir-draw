<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_delete_profile_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/varela_round_regular"
            android:text="@string/event_invite_title"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/closeInviteDialogButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/event_invite_close"
            android:src="@drawable/clear"
            android:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/inviteBodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/varela_round_regular"
        android:lineSpacingExtra="2dp"
        android:text="@string/event_invite_body"
        android:textColor="#B9BCC2"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/acceptInviteButton"
        android:layout_width="193dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/event_invite_accept"
        android:textAllCaps="false"
        android:textColor="#1D1D1D"
        android:textSize="16sp"
        app:backgroundTint="#FFFFFFFF"
        app:cornerRadius="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/declineInviteButton"
        android:layout_width="193dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/event_invite_decline"
        android:textAllCaps="false"
        android:textColor="#1D1D1D"
        android:textSize="16sp"
        app:backgroundTint="#FFFFFFFF"
        app:cornerRadius="20dp" />
</LinearLayout>
