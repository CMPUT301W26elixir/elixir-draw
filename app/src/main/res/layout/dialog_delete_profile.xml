<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="342dp"
    android:layout_height="342dp"
    android:background="@drawable/bg_delete_profile_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/deleteProfileDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/varela_round_regular"
            android:text="@string/delete_profile_dialog_title"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/closeDeleteDialogButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/delete_profile_dialog_close"
            android:src="@drawable/clear"
            android:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/deleteProfileDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fontFamily="@font/varela_round_regular"
        android:lineSpacingExtra="2dp"
        android:text="@string/delete_profile_dialog_message"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stayButton"
        android:layout_width="193dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/delete_profile_dialog_stay"
        android:textAllCaps="false"
        android:textColor="#FF84E49D"
        android:textSize="16sp"
        app:backgroundTint="#FF5A994A"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmDeleteProfileButton"
        android:layout_width="193dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/varela_round_regular"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="@string/delete_profile_dialog_confirm"
        android:textAllCaps="false"
        android:textColor="#FFFF7E5D"
        android:textSize="16sp"
        app:backgroundTint="#FF9E4141"
        app:cornerRadius="16dp" />
</LinearLayout>
